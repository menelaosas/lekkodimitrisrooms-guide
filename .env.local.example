# ─── Contact Form ────────────────────────────────────────────────────────────
# Option A: Formspree (recommended for small medical sites no server needed)
# Get your endpoint at https://formspree.io
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID

# Option B: Resend (if you want email sent via server action)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# CONTACT_EMAIL_TO=info@pathologoskalogiratou.gr
# CONTACT_EMAIL_FROM=noreply@pathologoskalogiratou.gr

# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://pathologoskalogiratou.gr
